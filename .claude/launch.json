{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 5173,
      "cwd": "${workspaceFolder}/frontend"
    },
    {
      "name": "backend",
      "runtimeExecutable": ".venv/bin/uvicorn",
      "runtimeArgs": ["main:app", "--reload", "--port", "8000", "--host", "127.0.0.1"],
      "port": 8000,
      "cwd": "${workspaceFolder}/backend"
    }
  ]
}
