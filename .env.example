# Copy to `.env` and fill in. `.env` is gitignored.
# No secrets are required to run mcp-teacher locally yet — these are
# placeholders for keys you'll need as later worlds unlock external services.

# Anthropic API key (used in later worlds when a lesson requires
# calling Claude — e.g. testing sampling, prompts in real contexts).
ANTHROPIC_API_KEY=

# Override which Python the grader uses to spawn student MCP servers.
# Defaults to the same interpreter as the FastAPI process.
# MCP_TEACHER_PYTHON=/usr/local/bin/python3.13

# OAuth client credentials used in World 7 (Boss Fight: Auth).
# Filled in when that world is unlocked.
# OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=
